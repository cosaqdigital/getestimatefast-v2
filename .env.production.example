# GetEstimateFast Production release template.
# Documentation only. Do not store real secrets in Git.
# Install values in Vercel Production only after the Production database migration is reviewed and applied.

# Independent GetEstimateFast Production Supabase.
GETESTIMATEFAST_SUPABASE_URL=https://wedsjubkttygxtpkopfj.supabase.co
GETESTIMATEFAST_SUPABASE_SECRET_KEY=
GETESTIMATEFAST_SUPABASE_PUBLISHABLE_KEY=
GETESTIMATEFAST_ISOLATED_BACKEND=false

# Public application origin.
GETESTIMATEFAST_PUBLIC_ORIGIN=https://www.getestimatefast.com

# Main lead intake. Production code fails closed when persistence is disabled.
LEAD_PERSISTENCE_ENABLED=true

# Professional account rollout.
# Keep signup false until Production SMTP and the published legal documents are verified.
CONTRACTOR_SIGNUP_ENABLED=false
CONTRACTOR_PROFILE_EDITING_ENABLED=true
GETESTIMATEFAST_PRIVACY_VERSION=privacy-2026-10-26
GETESTIMATEFAST_TERMS_VERSION=terms-2026-10-26

# Public professional profile estimate requests.
# Enable only after the profile-origin schema and pricing RPC are present in Production.
GETESTIMATEFAST_PROFILE_REQUESTS_MODE=live
GETESTIMATEFAST_PROFILE_REQUESTS_LIVE_APPROVED=false
GETESTIMATEFAST_REVIEW_IDENTITY_SECRET=

# Production marketplace. Both flags are required and fail closed.
# Turn them true only after the reviewed Production schema migration and smoke tests.
GETESTIMATEFAST_MARKETPLACE_PRODUCTION_ENABLED=false
GETESTIMATEFAST_MARKETPLACE_SCHEMA_APPROVED=false

# Telnyx SMS remains fail-closed until 10DLC Brand + Campaign approval and controlled testing.
GETESTIMATEFAST_SMS_MODE=disabled
# Second independent gate. Keep false through controlled testing and queue validation.
GETESTIMATEFAST_SMS_LIVE_APPROVED=false
# Canary gate: allows the cron to send only to GETESTIMATEFAST_TELNYX_TEST_TO while mode stays controlled_test.
GETESTIMATEFAST_SMS_CANARY_AUTOMATION_APPROVED=false
# Independent live automation gate. Keep false until canary validation is complete.
GETESTIMATEFAST_SMS_AUTOMATION_APPROVED=false
# Conservative launch limits. Worker validates 1-5 per run and 1-2000 per rolling 24h.
GETESTIMATEFAST_SMS_LIVE_BATCH_LIMIT=1
GETESTIMATEFAST_SMS_LIVE_DAILY_LIMIT=200
# Vercel Cron authentication secret (server-only, random >=16 chars).
CRON_SECRET=
GETESTIMATEFAST_SMS_PROVIDER=telnyx
GETESTIMATEFAST_TELNYX_API_KEY=
GETESTIMATEFAST_TELNYX_FROM_NUMBER=+18133039893
GETESTIMATEFAST_TELNYX_TEST_TO=
GETESTIMATEFAST_TELNYX_10DLC_BRAND_APPROVED=false
GETESTIMATEFAST_TELNYX_10DLC_CAMPAIGN_APPROVED=false
GETESTIMATEFAST_TELNYX_PUBLIC_KEY=

# Google-authenticated reviews stay disabled for the first release.
GETESTIMATEFAST_REVIEW_GOOGLE_ENABLED=false
GETESTIMATEFAST_REVIEW_SCHEMA_APPROVED=false
GETESTIMATEFAST_REVIEW_AUTH_COOKIE_SECRET=

# Development administrator recovery must never be enabled in Production.
GETESTIMATEFAST_ADMIN_RECOVERY_ENABLED=false
# Production reset remains fail-closed until the redirect URL and release are approved.
GETESTIMATEFAST_ADMIN_PASSWORD_RESET_ENABLED=false
# Temporary guarded staging gate for the protected Vercel project alias only. Keep false except during staged reset validation.
GETESTIMATEFAST_ADMIN_PASSWORD_RESET_STAGED_TEST=false

# Stripe Sandbox/test surfaces are never enabled in Production.
GETESTIMATEFAST_STRIPE_MODE=disabled
GETESTIMATEFAST_STRIPE_TEST_CHECKOUT_APPROVED=false
GETESTIMATEFAST_STRIPE_TEST_SCHEMA_APPROVED=false
GETESTIMATEFAST_STRIPE_TEST_WEBHOOK_ENABLED=false

# Stripe live contact checkout. Keep every gate false until schema, account identity,
# webhook endpoint and one controlled real-payment test are explicitly approved.
GETESTIMATEFAST_STRIPE_LIVE_ENABLED=false
GETESTIMATEFAST_STRIPE_LIVE_CHECKOUT_APPROVED=false
GETESTIMATEFAST_STRIPE_LIVE_WEBHOOK_ENABLED=false
GETESTIMATEFAST_STRIPE_LIVE_SCHEMA_APPROVED=false
GETESTIMATEFAST_STRIPE_LIVE_ACCOUNT_ID=
GETESTIMATEFAST_STRIPE_LIVE_SECRET_KEY=
GETESTIMATEFAST_STRIPE_LIVE_WEBHOOK_SECRET=

# Existing lead email notification. Verify the already-approved Resend sender before setting.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
CONTRACTOR_NOTIFICATION_TO_EMAIL=
CONTRACTOR_NOTIFICATION_FROM_EMAIL=


# Professional portal Google OAuth. Keep disabled until callback/redirect validation is complete.
GETESTIMATEFAST_CONTRACTOR_GOOGLE_ENABLED=false
# Optional dedicated secret. If omitted, the review auth secret is reused with domain-separated key derivation.
GETESTIMATEFAST_CONTRACTOR_AUTH_COOKIE_SECRET=
