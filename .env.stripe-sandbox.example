# Documentation only. No values are installed by this PR.
# Preview ONLY: feat/stripe-sandbox-safety-20261012; separate rollout approval.
# Copy the existing isolated Development baseline, not production credentials.
GETESTIMATEFAST_STRIPE_MODE=test
GETESTIMATEFAST_STRIPE_TEST_CHECKOUT_APPROVED=false
GETESTIMATEFAST_STRIPE_TEST_SCHEMA_APPROVED=false
GETESTIMATEFAST_STRIPE_TEST_WEBHOOK_ENABLED=false
# Secret, server-side, Sandbox only. Never NEXT_PUBLIC_, argv, logs or Git.
GETESTIMATEFAST_STRIPE_TEST_SECRET_KEY=
# CLI relay and registered endpoints have different signing secrets.
GETESTIMATEFAST_STRIPE_TEST_WEBHOOK_SECRET=
# Must match this branch's verified HTTPS Preview; freezes on each order.
GETESTIMATEFAST_PUBLIC_ORIGIN=
GETESTIMATEFAST_SMS_MODE=dry_run
CONTRACTOR_SIGNUP_ENABLED=false
LEAD_PERSISTENCE_ENABLED=false
