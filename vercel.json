{
  "rewrites": [
    {"source": "/professionals/:slug", "destination": "/api/public-profile?slug=:slug&format=html"}
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "getestimatefast.com"
        }
      ],
      "destination": "https://www.getestimatefast.com/$1",
      "permanent": true
    }
  ]
}
